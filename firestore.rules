rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla para la colección active_streams
    match /active_streams/{streamId} {
      // Permitir lectura a todos los usuarios autenticados
      allow read: if request.auth != null;
      
      // Permitir crear streams solo si el userId coincide con el usuario autenticado
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid;
      
      // Permitir actualizar el stream si es el creador
      allow update: if request.auth != null 
                    && (resource.data.userId == request.auth.uid 
                        || request.resource.data.keys().hasOnly(['viewerCount']));
      
      // Permitir eliminar solo al creador
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }
    
    // Regla para la colección users (si existe)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Regla temporal más permisiva para testing (REMOVER EN PRODUCCIÓN)
    // Descomentar solo si necesitas testing rápido
    // match /{document=**} {
    //   allow read, write: if request.auth != null;
    // }
  }
}
